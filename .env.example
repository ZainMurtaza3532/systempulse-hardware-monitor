# ==============================================================================
# SystemPulse Configuration Template (.env.example)
# Copy this file to '.env' and adjust the settings as needed.
# ==============================================================================

# Application Window & Display
SYSTEMPULSE_WINDOW_WIDTH=1280
SYSTEMPULSE_WINDOW_HEIGHT=800
SYSTEMPULSE_VSYNC=true
SYSTEMPULSE_BORDERLESS=false
SYSTEMPULSE_THEME=DARK

# Telemetry Polling Intervals (in seconds: 0.5, 1.0, 2.0)
SYSTEMPULSE_REFRESH_INTERVAL_SEC=1.0

# Hardware Monitoring Subsystems
SYSTEMPULSE_ENABLE_NVML=true
SYSTEMPULSE_ENABLE_NETWORK_MONITOR=true
SYSTEMPULSE_ENABLE_DISK_MONITOR=true

# Alert & Warning Thresholds (Percentages / Degrees Celsius)
SYSTEMPULSE_ALERT_CPU_THRESHOLD=90.0
SYSTEMPULSE_ALERT_RAM_THRESHOLD=85.0
SYSTEMPULSE_ALERT_GPU_TEMP_THRESHOLD=80.0

# Logging & Diagnostics
SYSTEMPULSE_ENABLE_LOGGING=false
SYSTEMPULSE_LOG_LEVEL=INFO

